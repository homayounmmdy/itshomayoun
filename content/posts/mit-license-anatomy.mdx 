### ۲. اسکریپت Node.js برای افزودن هدر MIT به فایل‌های جدید

```javascript
// scripts/add-mit-header.js
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const COPYRIGHT_HEADER = `/*
 * Copyright (c) 2026 Homayoun Mohammadi
 * This software is licensed under the MIT License.
 * See the LICENSE file in the project root for full license information.
 */\n\n`;

function addHeaderToFiles(dir) {
  const files = fs.readdirSync(dir);

  for (const file of files) {
    const filePath = path.join(dir, file);
    const stat = fs.statSync(filePath);

    if (stat.isDirectory()) {
      // ✅ بررسی پوشه‌های تو در تو (به جز node_modules)
      if (file !== 'node_modules' && !file.startsWith('.')) {
        addHeaderToFiles(filePath);
      }
    } else if (file.endsWith('.js') || file.endsWith('.ts') || file.endsWith('.jsx') || file.endsWith('.tsx')) {
      const content = fs.readFileSync(filePath, 'utf-8');
      
      // ❌ اگر هدر از قبل وجود داشت، کاری نکن
      if (content.includes('Copyright (c) 2026')) {
        console.log(`⏭️ رد شد: ${file}`);
        continue;
      }

      // ✅ افزودن هدر به ابتدای فایل
      fs.writeFileSync(filePath, COPYRIGHT_HEADER + content);
      console.log(`✅ هدر اضافه شد: ${file}`);
    }
  }
}

// اجرای اسکریپت روی پوشه src
addHeaderToFiles(path.join(__dirname, '../src'));
```

