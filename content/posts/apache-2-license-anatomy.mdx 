### 4. اسکریپت بررسی compliance برای Apache 2.0

```javascript
// scripts/check-apache-compliance.js
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const APACHE_HEADER = `Licensed under the Apache License, Version 2.0`;
const COPYRIGHT_PATTERN = /Copyright \d{4} .+/;

function checkApacheCompliance(dir) {
  const files = fs.readdirSync(dir);
  const violations = [];
  const checked = [];

  for (const file of files) {
    const filePath = path.join(dir, file);
    const stat = fs.statSync(filePath);

    if (stat.isDirectory()) {
      if (file !== 'node_modules' && !file.startsWith('.')) {
        const subResult = checkApacheCompliance(filePath);
        violations.push(...subResult.violations);
        checked.push(...subResult.checked);
      }
    } else if (file.endsWith('.js') || file.endsWith('.ts') || file.endsWith('.jsx') || file.endsWith('.tsx')) {
      const content = fs.readFileSync(filePath, 'utf-8');
      checked.push(filePath);

      // ❌ بررسی وجود هدر Apache
      if (!content.includes(APACHE_HEADER)) {
        violations.push({
          file: filePath,
          issue: '❌ هدر Apache License پیدا نشد',
        });
      }

      // ❌ بررسی وجود Copyright
      if (!COPYRIGHT_PATTERN.test(content)) {
        violations.push({
          file: filePath,
          issue: '❌ خط Copyright پیدا نشد',
        });
      }
    }
  }

  return { violations, checked };
}

// ✅ اجرای بررسی
const result = checkApacheCompliance(path.join(__dirname, '../src'));

console.log(`\n📊 بررسی Apache 2.0 Compliance:`);
console.log(`   فایل‌های بررسی شده: ${result.checked.length}`);
console.log(`   نقض‌ها: ${result.violations.length}`);

if (result.violations.length > 0) {
  console.log('\n🚨 نقض‌های پیدا شده:');
  result.violations.forEach(v => {
    console.log(`   ${v.file}: ${v.issue}`);
  });
  process.exit(1);
} else {
  console.log('\n✅ تمام فایل‌ها با Apache 2.0 سازگار هستند!');
}
```

